{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "trailingSlash": true,
  "functions": {
    "api/sync-members.js": {
      "maxDuration": 150
    },
    "api/scheduled-sync.js": {
      "maxDuration": 150
    },
    "api/email-status.js": {
      "maxDuration": 60
    },
    "api/login.js": {
      "maxDuration": 60
    },
    "api/account.js": {
      "maxDuration": 60
    },
    "api/admin-operations.js": {
      "maxDuration": 60
    },
    "api/manual-bookings.js": {
      "maxDuration": 60
    }
  },
  "redirects": [
    {
      "source": "/octoberhalfterm/",
      "destination": "/events/",
      "permanent": true
    },
    {
      "source": "/parties/non-member/",
      "destination": "/parties/?type=dynamo",
      "permanent": true
    },
    {
      "source": "/parties/biggym-member/",
      "destination": "/parties/?type=dynamo",
      "permanent": true
    },
    {
      "source": "/parties/biggym-nonmember/",
      "destination": "/parties/?type=dynamo",
      "permanent": true
    },
    {
      "source": "/parties/smallgym-nonmember/",
      "destination": "/parties/?type=preschool",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/events/:slug/",
      "destination": "/events/detail/"
    }
  ]
}
