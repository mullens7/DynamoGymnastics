{
  "buildCommand": "npm test && npm run build",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "trailingSlash": true,
  "functions": {
    "api/sync-members.js": {
      "maxDuration": 300
    },
    "api/scheduled-sync.js": {
      "maxDuration": 300
    },
    "api/email-status.js": {
      "maxDuration": 60
    },
    "api/login.js": {
      "maxDuration": 60
    },
    "api/account.js": {
      "maxDuration": 60
    },
    "api/admin-operations.js": {
      "maxDuration": 60
    },
    "api/admin-records.js": {
      "maxDuration": 60
    },
    "api/results.js": {
      "maxDuration": 60
    }
  },
  "redirects": [
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "auth.dynamogymnastics.co.uk"
        }
      ],
      "destination": "/auth/",
      "permanent": false
    },
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "manage.dynamogymnastics.co.uk"
        }
      ],
      "destination": "/manage/",
      "permanent": false
    },
    {
      "source": "/octoberhalfterm/",
      "destination": "/events/",
      "permanent": true
    },
    {
      "source": "/parties/non-member/",
      "destination": "/parties/?type=dynamo",
      "permanent": true
    },
    {
      "source": "/parties/biggym-member/",
      "destination": "/parties/?type=dynamo",
      "permanent": true
    },
    {
      "source": "/parties/biggym-nonmember/",
      "destination": "/parties/?type=dynamo",
      "permanent": true
    },
    {
      "source": "/parties/smallgym-nonmember/",
      "destination": "/parties/?type=preschool",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/api/stripe-webhook/",
      "destination": "/api/results/?kind=stripe-webhook"
    },
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "auth.dynamogymnastics.co.uk"
        }
      ],
      "destination": "/auth/"
    },
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "manage.dynamogymnastics.co.uk"
        }
      ],
      "destination": "/manage/"
    },
    {
      "source": "/events/:slug/",
      "destination": "/events/detail/"
    },
    {
      "source": "/_files/ugd/:path*",
      "destination": "/assets/policies/:path*"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        }
      ]
    },
    {
      "source": "/auth/:path*",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/manage/:path*",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/account/:path*",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/book/:path*",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/staff/:path*",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/api/:path*",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    }
  ]
}
